@page
@model IndexModel
@{
    ViewData["Title"] = "Профил";
    ViewData["ActivePage"] = ManageNavPages.Index;
}

<h1 class="auth-title">@ViewData["Title"]</h1>
<p class="auth-lead">Тук можете да промените телефонния си номер.</p>

<partial name="_StatusMessage" for="StatusMessage" />

<form id="profile-form" method="post">
    <div asp-validation-summary="ModelOnly" class="auth-summary" role="alert"></div>

    <div class="form-floating mb-3">
        <input asp-for="Username" class="form-control" placeholder="Потребителско име" disabled />
        <label asp-for="Username">Потребителско име</label>
    </div>

    <div class="form-floating mb-4">
        <input asp-for="Input.PhoneNumber" class="form-control" placeholder="Телефонен номер" />
        <label asp-for="Input.PhoneNumber">Телефонен номер</label>
        <span asp-validation-for="Input.PhoneNumber" class="auth-error"></span>
    </div>

    <button id="update-profile-button" type="submit" class="btn btn-lg w-100 auth-btn">Запази промените</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
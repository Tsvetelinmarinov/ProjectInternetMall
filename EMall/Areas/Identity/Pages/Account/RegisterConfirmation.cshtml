@page
@model RegisterConfirmationModel
@{
    ViewData["Title"] = "Потвърждение на регистрацията";
}

<style>
    .auth-shell {
        --auth-deep: #0e3b43;
        --auth-deep-2: #17606c;
        --auth-accent: #f5b544;
        --auth-accent-hover: #e9a52d;
        --auth-text: #17262b;
        --auth-muted: #5e6f74;
        --auth-line: #d3dde0;
        display: grid;
        grid-template-columns: 1fr;
        max-width: 56rem;
        margin: 0 auto;
        background: #fff;
        color: var(--auth-text);
        border: 1px solid var(--auth-line);
        border-radius: 1.25rem;
        overflow: hidden;
        box-shadow: 0 1.5rem 3rem -1.5rem rgba(14, 59, 67, .35);
    }

    @@media (min-width: 768px) {
        .auth-shell {
            grid-template-columns: 5fr 6fr;
        }
    }

    .auth-aside {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        gap: 1.25rem;
        padding: 1.75rem 2rem;
        color: #fff;
        background: radial-gradient(circle at 100% 100%, var(--auth-deep-2) 0 9rem, transparent 9.05rem), radial-gradient(circle at 100% 100%, rgba(255, 255, 255, .07) 0 15rem, transparent 15.05rem), var(--auth-deep);
    }

    @@media (min-width: 768px) {
        .auth-aside {
            gap: 2.5rem;
            padding: 3rem;
            min-height: 28rem;
        }

        .auth-sub {
            display: block;
        }
    }

    .auth-brand {
        font-size: 1.25rem;
        font-weight: 800;
        letter-spacing: -.01em;
    }

    .auth-tagline {
        margin: 0;
        max-width: 9em;
        font-size: clamp(1.75rem, 4vw, 2.6rem);
        font-weight: 800;
        line-height: 1.1;
        text-wrap: balance;
    }

    .auth-sub {
        display: none;
        margin: 1rem 0 0;
        color: rgba(255, 255, 255, .75);
    }

    .auth-main {
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: 2rem 1.5rem;
    }

    @@media (min-width: 768px) {
        .auth-main {
            padding: 3rem;
        }
    }

    .auth-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 3.5rem;
        height: 3.5rem;
        margin-bottom: 1.25rem;
        color: var(--auth-deep-2);
        background: #e6f1f3;
        border-radius: 1rem;
    }

    .auth-title {
        margin: 0 0 .5rem;
        font-size: 1.75rem;
        font-weight: 700;
    }

    .auth-lead {
        margin: 0 0 1.5rem;
        color: var(--auth-muted);
    }

    .auth-note {
        margin: 0 0 1.5rem;
        padding: .75rem 1rem;
        font-size: .875rem;
        color: var(--auth-muted);
        background: #f4f7f8;
        border-radius: .75rem;
    }

    .auth-note a {
        color: var(--auth-deep-2);
        font-weight: 600;
    }

    .auth-shell .auth-btn {
        padding: .9rem 1rem;
        font-weight: 700;
        color: #3a2a00;
        background-color: var(--auth-accent);
        border: 0;
        border-radius: .75rem;
    }

    .auth-shell .auth-btn:hover,
    .auth-shell .auth-btn:active {
        color: #3a2a00;
        background-color: var(--auth-accent-hover);
    }

    .auth-shell .auth-btn:focus-visible {
        outline: 3px solid var(--auth-deep-2);
        outline-offset: 2px;
    }
</style>

<div class="py-4 py-md-5">
    <div class="auth-shell">

        <aside class="auth-aside">
            <span class="auth-brand">EMall</span>
            <div>
                <p class="auth-tagline">Всичко на едно място.</p>
                <p class="auth-sub">Един профил за целия магазин.</p>
            </div>
        </aside>

        <div class="auth-main">
            <div class="auth-icon" aria-hidden="true">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="2" y="4" width="20" height="16" rx="3" />
                    <path d="M2 7l10 7 10-7" />
                </svg>
            </div>

            @if (Model.DisplayConfirmAccountLink)
            {
                <h1 class="auth-title">Потвърдете профила си</h1>
                <p class="auth-lead">Профилът ви е създаден. Остава само да го потвърдите.</p>

                <p class="auth-note">
                    В приложението още не е настроен изпращач на имейли. Вижте
                    <a href="https://aka.ms/aspaccountconf">документацията</a>
                    как да го конфигурирате. Обикновено този линк се изпраща по имейл.
                </p>

                <a id="confirm-link" class="btn btn-lg w-100 auth-btn" href="@Model.EmailConfirmationUrl">Потвърди профила</a>
            }
            else
            {
                <h1 class="auth-title">Проверете имейла си</h1>
                <p class="auth-lead">Изпратихме ви линк за потвърждение. Отворете го, за да активирате профила си.</p>
            }
        </div>

    </div>
</div>
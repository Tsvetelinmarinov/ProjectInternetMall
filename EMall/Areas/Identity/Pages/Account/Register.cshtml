@page
@model RegisterModel
@{
    ViewData["Title"] = "Register";
}

<div class="row justify-content-center align-items-center py-5">
    <div class="col-md-6 col-lg-5 col-xl-4">
        <form id="registerForm" 
              asp-route-returnUrl="@Model.ReturnUrl" 
              method="post"
              class="p-4 p-md-5 rounded-4 shadow-lg border-0 bg-white">
            <h2 class="fw-bold text-center mb-3 text-dark fs-3">Create a new account.</h2>
            <hr class="text-muted mb-4 opacity-50" />
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3 text-center" role="alert"></div>
            <div class="form-floating mb-3">
                <input asp-for="Input.Email" class="form-control rounded-3 shadow-none" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                <label asp-for="Input.Email" class="text-muted">Email</label>
                <span asp-validation-for="Input.Email" class="text-danger small mt-1 d-block"></span>
            </div>
            <div class="form-floating mb-3">
                <input asp-for="Input.Password" class="form-control rounded-3 shadow-none" autocomplete="new-password" aria-required="true" placeholder="password" />
                <label asp-for="Input.Password" class="text-muted">Password</label>
                <span asp-validation-for="Input.Password" class="text-danger small mt-1 d-block"></span>
            </div>
            <div class="form-floating mb-4">
                <input asp-for="Input.ConfirmPassword" class="form-control rounded-3 shadow-none" autocomplete="new-password" aria-required="true" placeholder="password" />
                <label asp-for="Input.ConfirmPassword" class="text-muted">Confirm Password</label>
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger small mt-1 d-block"></span>
            </div>
            <button id="registerSubmit" 
                    type="submit" 
                    class="w-100 btn btn-lg btn-primary rounded-3 py-3 fw-semibold shadow-sm">
                    Register
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
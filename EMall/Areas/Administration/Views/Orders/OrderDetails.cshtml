@model OrderViewModel

@{
    ViewData["Title"] = $"Преглед на поръчка #{Model.OrderId}";
    // Проверка дали статусът позволява редакция
    bool isProcessing = Model.Status.ToString() == "Processing";
    var products = Model.Products ?? new();
    var productPageCount = (products.Count + 3) / 4;
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow border-0 rounded-4">
                <!-- Картов хедър с динамичен цвят спрямо статуса -->
                <div class="card-header bg-secondary text-white p-4 rounded-top-4 d-flex justify-content-between align-items-center">
                    <div>
                        <h3 class="mb-0 fw-bold">Поръчка № @Model.OrderId</h3>
                        <p class="mb-0 text-white-50 small">Управление и детайли за поръчката</p>
                    </div>
                    <div>
                        <span class="badge bg-light text-dark fs-6 px-3 py-2 shadow-sm">
                            @Model.Status
                        </span>
                    </div>
                </div>

                <div class="card-body p-4 p-md-5">
                    <!-- Известие, ако поръчката не подлежи на редакция -->
                    <div class="alert alert-warning border-0 shadow-sm d-flex align-items-center mb-4" role="alert">
                        <i class="bi bi-exclamation-triangle-fill flex-shrink-0 me-2 fs-5"></i>
                        <div>
                            Тази поръчка е със статус <strong>@Model.Status</strong> и не може да бъде редактирана. Редакция е възможна само при статус <strong>Processing</strong>.
                        </div>
                    </div>

                    <section class="mb-4" aria-labelledby="products-heading">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h4 id="products-heading" class="h5 mb-0">Продукти в поръчката</h4>
                            <span class="badge bg-light text-dark">@products.Count</span>
                        </div>

                        @if (products.Count > 0)
                        {
                            <div id="order-products" class="d-grid gap-3">
                                @for (var index = 0; index < products.Count; index++)
                                {
                                    var orderProduct = products[index];
                                    var pageNumber = (index / 4) + 1;
                                    <article class="card border rounded-3" data-product-page="@pageNumber">
                                        <div class="card-body">
                                            @if (orderProduct.Product is { } product)
                                            {
                                                <div class="d-flex flex-wrap justify-content-between gap-2 mb-2">
                                                    <h5 class="card-title mb-0">@product.ProductName</h5>
                                                    <span class="fw-semibold text-success">@product.Price.ToString("N2") евро.</span>
                                                </div>

                                                <p class="text-muted small mb-2">Продукт № @orderProduct.ProductId</p>

                                                @if (!string.IsNullOrWhiteSpace(product.Description))
                                                {
                                                    <p class="card-text mb-3">@product.Description</p>
                                                }

                                                @if (product.Category is not null)
                                                {
                                                    <p class="small mb-3">
                                                        <i class="bi @product.Category.Icon me-1" style="color: @product.Category.Color"></i>
                                                        <strong>Категория:</strong> @product.Category.CategoryName
                                                        <span class="text-muted">— @product.Category.CategoryDescription</span>
                                                    </p>
                                                }

                                                @if (product.Claims.Any())
                                                {
                                                    <div>
                                                        <h6 class="small fw-semibold">Характеристики</h6>
                                                        <dl class="row small mb-0">
                                                            @foreach (var claim in product.Claims)
                                                            {
                                                                <dt class="col-sm-4">@claim.ClaimName</dt>
                                                                <dd class="col-sm-8">@claim.ClaimValue</dd>
                                                            }
                                                        </dl>
                                                    </div>
                                                }
                                            }
                                            else
                                            {
                                                <p class="text-muted mb-0">Продукт № @orderProduct.ProductId — информацията за продукта не е налична.</p>
                                            }
                                        </div>
                                    </article>
                                }
                            </div>

                            @if (productPageCount > 1)
                            {
                                <nav class="d-flex justify-content-center gap-2 mt-4" aria-label="Страници на продуктите" data-products-pagination>
                                    @for (var pageNumber = 1; pageNumber <= productPageCount; pageNumber++)
                                    {
                                         <button type="button"
                                                 class="btn btn-sm rounded-circle p-0 @(pageNumber == 1 ? "btn-primary" : "btn-outline-primary")"
                                                 style="width: 0.75rem; height: 0.75rem;"
                                                 data-products-page="@pageNumber"
                                                 aria-label="Страница @pageNumber"
                                                 aria-current="@(pageNumber == 1 ? "page" : null)">
                                             <span class="visually-hidden">Страница @pageNumber</span>
                                         </button>
                                    }
                                </nav>
                            }
                        }
                        else
                        {
                            <p class="text-muted mb-0">В тази поръчка няма свързани продукти.</p>
                        }
                    </section>

                    <form asp-action="EditOrder" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                        
                        <input type="hidden" asp-for="OrderId" />

                        <div class="row g-3">
                            <!-- Име на клиент -->
                            <div class="col-md-12">
                                <label asp-for="CustomerName" class="form-label fw-semibold text-muted">Име на клиент</label>
                                <div class="form-control-plaintext fs-5 border-bottom pb-2">@Model.CustomerName</div>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="CustomerEmail" class="form-label fw-semibold text-muted">Имейл</label>
                                <div class="form-control-plaintext fs-6 border-bottom pb-2">@Model.CustomerEmail</div>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="AddressForShipping" class="form-label fw-semibold text-muted">Адрес за доставка</label>
                                <div class="form-control-plaintext fs-6 border-bottom pb-2">@Model.AddressForShipping</div>
                            </div>

                            <!-- Статус -->
                            <div class="col-md-6">
                                <label asp-for="Status" class="form-label fw-semibold text-muted">Статус</label>
                                <div class="form-control-plaintext fs-5 border-bottom pb-2">@Model.Status</div>
                            </div>

                            <!-- Обща сума -->
                            <div class="col-md-6">
                                <label asp-for="TotalPrice" class="form-label fw-semibold text-muted">Обща сума</label>
                                <div class="form-control-plaintext fs-5 border-bottom pb-2 text-success fw-bold">@Model.TotalPrice.ToString("F2") лв.</div>
                            </div>

                            <!-- Дата на създаване (винаги само за четене) -->
                            <div class="col-md-12">
                                <label asp-for="CreatedOn" class="form-label fw-semibold text-muted">Дата на създаване</label>
                                <div class="form-control-plaintext fs-5 border-bottom pb-2 text-secondary">
                                    @Model.CreatedOn.ToString("dd.MM.yyyy г. в HH:mm ч.")
                                </div>
                            </div>
                        </div>

                        <!-- Бутони за действие -->
                        <div class="d-flex justify-content-between align-items-center mt-5 pt-3 border-top">
                            <a asp-action="Index" class="btn btn-outline-secondary px-4">
                                <i class="bi bi-arrow-left me-1"></i> Назад към списъка
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        const productCards = document.querySelectorAll("[data-product-page]");
        const productPageButtons = document.querySelectorAll("[data-products-page]");

        productPageButtons.forEach((button) => {
            button.addEventListener("click", () => {
                const page = button.dataset.productsPage;

                productCards.forEach((card) => {
                    const isVisible = card.dataset.productPage === page;
                    card.classList.toggle("d-none", !isVisible);
                    card.setAttribute("aria-hidden", String(!isVisible));
                });

                productPageButtons.forEach((pageButton) => {
                    const isActive = pageButton === button;
                    pageButton.classList.toggle("btn-primary", isActive);
                    pageButton.classList.toggle("btn-outline-primary", !isActive);

                    if (isActive) {
                        pageButton.setAttribute("aria-current", "page");
                    } else {
                        pageButton.removeAttribute("aria-current");
                    }
                });
            });
        });

        if (productPageButtons.length > 0) {
            productPageButtons[0].click();
        }
    </script>
}
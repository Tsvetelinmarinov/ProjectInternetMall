@model EMall.Areas.Administration.ViewModels.AdminDashboardViewModel
@using System.Globalization
@{
    ViewData["Title"] = "Админ панел";

    var bg = CultureInfo.GetCultureInfo("bg-BG");
    var inv = CultureInfo.InvariantCulture;
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "Home";
    var totalProducts = Model.Categories.Sum(c => c.ProductsCount);
    var hasTodo = Model.PendingOrders > 0 || Model.LowStock.Any();

    // Смени валутата тук, ако не ползваш евро
    string Money(decimal value) => value.ToString("N2", bg) + " €";
    double Pct(int n) => totalProducts > 0 ? n * 100.0 / totalProducts : 0;
    string Active(string name) => string.Equals(controller, name, StringComparison.OrdinalIgnoreCase) ? "is-active" : "";
    string StatusClass(string status) => status switch
    {
        "Нова" => "is-new",
        "Обработва се" => "is-warn",
        "Доставена" => "is-ok",
        "Отказана" => "is-bad",
        _ => ""
    };
}

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Golos+Text:wght@400..700&display=swap" rel="stylesheet" />
<link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />

<div class="adm">

    <aside class="adm-side" aria-label="Админ навигация">
        <a class="adm-brand" asp-area="Admin" asp-controller="Home" asp-action="Index">
            <span class="adm-mark">E</span>
            <span class="adm-brand-text"><strong>EMall</strong><small>Админ панел</small></span>
        </a>

        <nav class="adm-nav">
            <p class="adm-nav-title">Магазин</p>
            <a class="adm-link @(Active("Home"))" asp-area="Admin" asp-controller="Home" asp-action="Index">Табло</a>
            <a class="adm-link @(Active("Products"))" asp-area="Admin" asp-controller="Products" asp-action="Index">Продукти</a>
            <a class="adm-link @(Active("Categories"))" asp-area="Admin" asp-controller="Categories" asp-action="Index">Категории</a>
            <a class="adm-link @(Active("Orders"))" asp-area="Admin" asp-controller="Orders" asp-action="Index">
                Поръчки
                @if (Model.PendingOrders > 0)
                {
                    <span class="adm-chip is-new">@Model.PendingOrders</span>
                }
            </a>

            <p class="adm-nav-title">Потребители</p>
            <a class="adm-link @(Active("Users"))" asp-area="Admin" asp-controller="Users" asp-action="Index">Акаунти и роли</a>
        </nav>

        <div class="adm-side-foot">
            <p class="adm-user">@User.Identity?.Name</p>
            <a class="adm-link" asp-area="" asp-controller="Home" asp-action="Index">Към магазина</a>
            <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Content("~/")" method="post">
                <button type="submit" class="adm-link">Изход</button>
            </form>
        </div>
    </aside>

    <main class="adm-main">

        <header class="adm-head">
            <div>
                <h1 class="adm-title">Табло</h1>
                <p class="adm-date">@DateTime.Now.ToString("dddd, d MMMM yyyy", bg)</p>
            </div>
            <div class="adm-actions">
                <a class="adm-btn" asp-area="" asp-controller="Home" asp-action="Index">Виж магазина</a>
                <a class="adm-btn adm-btn--primary" asp-area="Admin" asp-controller="Products" asp-action="Create">Добави продукт</a>
            </div>
        </header>

        <section class="adm-stats" aria-label="Обобщение">
            <div class="adm-stat">
                <span class="adm-stat-label">Продукти</span>
                <strong class="adm-stat-value">@Model.ProductsCount.ToString("N0", bg)</strong>
                <span class="adm-stat-hint">В каталога</span>
            </div>
            <div class="adm-stat">
                <span class="adm-stat-label">Поръчки</span>
                <strong class="adm-stat-value">@Model.OrdersCount.ToString("N0", bg)</strong>
                <span class="adm-stat-hint">За обработка: @Model.PendingOrders</span>
            </div>
            <div class="adm-stat">
                <span class="adm-stat-label">Потребители</span>
                <strong class="adm-stat-value">@Model.UsersCount.ToString("N0", bg)</strong>
                <span class="adm-stat-hint">Нови тази седмица: @Model.NewUsersThisWeek</span>
            </div>
            <div class="adm-stat">
                <span class="adm-stat-label">Приходи</span>
                <strong class="adm-stat-value">@Money(Model.RevenueThisMonth)</strong>
                <span class="adm-stat-hint">За текущия месец</span>
            </div>
        </section>

        <div class="adm-row">

            <section class="adm-panel" aria-labelledby="cats-title">
                <div class="adm-panel-head">
                    <h2 class="adm-panel-title" id="cats-title">Продукти по категории</h2>
                    <a class="adm-more" asp-area="Admin" asp-controller="Categories" asp-action="Index">Управление</a>
                </div>

                @if (totalProducts > 0)
                {
                    <div class="adm-bar" role="img" aria-label="Разпределение на продуктите по категории">
                        @{ var i = 0; }
                        @foreach (var c in Model.Categories.Where(c => c.ProductsCount > 0))
                        {
                            <span class="adm-seg" style="--c:@c.Color; --w:@Pct(c.ProductsCount).ToString("0.##", inv)%; --i:@i" title="@c.CategoryName"></span>
                            i++;
                        }
                    </div>

                    <ul class="adm-cats">
                        @foreach (var c in Model.Categories)
                        {
                            <li class="adm-cat" style="--c:@c.Color">
                                <span class="adm-dot"></span>
                                <span>@c.CategoryName</span>
                                <span class="adm-cat-count">@c.ProductsCount</span>
                                <span class="adm-cat-pct">@Pct(c.ProductsCount).ToString("0", bg)%</span>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="adm-empty">Все още няма продукти. Добави първия от бутона горе.</p>
                }
            </section>

            <section class="adm-panel" aria-labelledby="todo-title">
                <div class="adm-panel-head">
                    <h2 class="adm-panel-title" id="todo-title">Изисква внимание</h2>
                </div>

                @if (hasTodo)
                {
                    <ul class="adm-todo">
                        @if (Model.PendingOrders > 0)
                        {
                            <li>
                                <a class="adm-todo-item" asp-area="Admin" asp-controller="Orders" asp-action="Index" asp-route-status="Нова">
                                    <span>Поръчки за обработка</span>
                                    <span class="adm-chip is-new">@Model.PendingOrders</span>
                                </a>
                            </li>
                        }
                        @foreach (var p in Model.LowStock)
                        {
                            <li>
                                <a class="adm-todo-item" asp-area="Admin" asp-controller="Products" asp-action="Edit" asp-route-id="@p.ProductId">
                                    <span>@p.ProductName</span>
                                    <span class="adm-chip is-warn">остават @p.Quantity</span>
                                </a>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="adm-empty">Всичко е наред. Няма чакащи поръчки и продукти с ниска наличност.</p>
                }
            </section>
        </div>

        <section class="adm-panel" aria-labelledby="orders-title">
            <div class="adm-panel-head">
                <h2 class="adm-panel-title" id="orders-title">Последни поръчки</h2>
                <a class="adm-more" asp-area="Admin" asp-controller="Orders" asp-action="Index">Всички поръчки</a>
            </div>

            @if (Model.RecentOrders.Any())
            {
                <div class="adm-scroll">
                    <table class="adm-table">
                        <caption class="adm-sr">Последни поръчки</caption>
                        <thead>
                            <tr>
                                <th scope="col">Поръчка</th>
                                <th scope="col">Клиент</th>
                                <th scope="col">Дата</th>
                                <th scope="col" class="adm-num">Сума</th>
                                <th scope="col">Статус</th>
                                <th scope="col"><span class="adm-sr">Действия</span></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var o in Model.RecentOrders)
                            {
                                <tr>
                                    <td>#@o.Id</td>
                                    <td>@o.CustomerEmail</td>
                                    <td>@o.CreatedOn.ToString("d MMM yyyy, HH:mm", bg)</td>
                                    <td class="adm-num">@Money(o.Total)</td>
                                    <td><span class="adm-chip @(StatusClass(o.Status))">@o.Status</span></td>
                                    <td class="adm-num">
                                        <a class="adm-more" asp-area="Admin" asp-controller="Orders" asp-action="Details" asp-route-id="@o.Id">Отвори</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="adm-empty">Още няма поръчки. Когато клиент направи първата, ще се покаже тук.</p>
            }
        </section>

    </main>
</div>

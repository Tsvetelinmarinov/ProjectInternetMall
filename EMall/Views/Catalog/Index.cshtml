@model IEnumerable<CategoryOutputViewModel>
@{
    ViewData["Title"] = "Каталог";
}

<link href="https://fonts.googleapis.com/css2?family=Sora:wght@600;700&display=swap" rel="stylesheet" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
<link rel="stylesheet" href="~/css/catalog.css" asp-append-version="true" />

<section class="catalog">
    <header class="catalog-head">
        <h1>Каталог</h1>
        <p>Избери категория по предназначение.</p>
    </header>

    <div class="row g-4">
        @for (var i = 0; i < Model.Count(); i++)
        {
            var categories = Model.ToArray();
            var c = categories[i];
            <div class="col-12 col-md-6 col-lg-4">
                <a class="cat-card"
                   asp-controller="" 
                   asp-action="" 
                   asp-route-category="">
                    <span class="cat-icon" aria-hidden="true"><i class="bi @c.Icon"></i></span>
                    <h2 class="cat-name">@c.CategoryName</h2>
                    <p class="cat-text">@c.CategoryDescription</p>
                    <span class="cat-foot">
                        <span class="cat-count">@((categories[i].Products ?? []).Count()) продукта</span>
                        <span class="cat-arrow" aria-hidden="true"><i class="bi bi-arrow-right"></i></span>
                    </span>
                </a>
            </div>
        }
    </div>
</section>

<script src="~/js/catalog.js" asp-append-version="true"></script>
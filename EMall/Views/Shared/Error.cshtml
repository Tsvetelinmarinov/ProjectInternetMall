@{
    ViewData["Title"] = "Страницата не е намерена";
}

<div class="error-wrapper d-flex align-items-center justify-content-center min-vh-100 py-5">
    <div class="error-card text-center p-4 p-sm-5 rounded-4 shadow-lg border-0 position-relative">

        <!-- Анимирано светещо чипче / статус -->
        <div class="d-inline-flex align-items-center gap-2 px-3 py-1.5 rounded-pill status-badge mb-4">
            <span class="status-dot"></span>
            <span class="fw-semibold fs-7 text-uppercase tracking-wider">Упс! Нещо се обърка!</span>
        </div>

        <!-- Анимиран 3D голям номер -->
        <div class="error-code-container mb-3 position-relative">
            <h1 class="error-code display-1 fw-black m-0 user-select-none">404</h1>
        </div>

        <!-- Заглавие и текст -->
        <h2 class="h3 fw-bold mb-3 text-headline">Търсената страница не съществува!</h2>
        <p class="text-description mb-4 mx-auto" style="max-width: 400px;">
            Възможно е адресът да е сгрешен или страницата да е преместена на нов адрес.
        </p>

        <!-- Модерен бутон за връщане -->
        <div class="pt-2">
            <a asp-controller="Home" asp-action="Index" class="btn btn-home btn-lg px-4 py-3 rounded-3 fw-bold text-white d-inline-flex align-items-center gap-2 shadow-sm">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                    <polyline points="9 22 9 12 15 12 15 22"></polyline>
                </svg>
                <span>Към началната страница</span>
            </a>
        </div>

    </div>
</div>

<style>
    /* Базови променливи за светла/тъмна тема */
    :root {
        --err-card-bg: #ffffff;
        --err-text-headline: #0f172a;
        --err-text-desc: #64748b;
        --err-badge-bg: #fef2f2;
        --err-badge-color: #ef4444;
        --err-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.08);
    }

    @@media (prefers-color-scheme: dark) {
        :root {
            --err-card-bg: #1e293b;
            --err-text-headline: #f8fafc;
            --err-text-desc: #94a3b8;
            --err-badge-bg: rgba(239, 68, 68, 0.15);
            --err-badge-color: #fca5a5;
            --err-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
        }
    }

    /* Карта на грешката */
    .error-card {
        background-color: var(--err-card-bg);
        box-shadow: var(--err-shadow);
        max-width: 500px;
        width: 100%;
        transition: transform 0.3s ease;
    }

    /* Текст стилове */
    .text-headline {
        color: var(--err-text-headline);
    }

    .text-description {
        color: var(--err-text-desc);
    }

    /* Бадж статус */
    .status-badge {
        background-color: var(--err-badge-bg);
        color: var(--err-badge-color);
    }

    .status-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background-color: currentColor;
        display: inline-block;
        animation: pulseDot 2s infinite ease-in-out;
    }

    /* Анимиран 404 текст с плаващ ефект (Float) */
    .error-code {
        font-size: 6.5rem;
        font-weight: 900;
        letter-spacing: -3px;
        background: linear-gradient(135deg, #6366f1 0%, #a855f7 50%, #ec4899 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        animation: floatAnimation 4s ease-in-out infinite;
    }

    /* Модерен бутон с градиент и hover анимация */
    .btn-home {
        background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%);
        border: none;
        transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .btn-home:hover {
        background: linear-gradient(135deg, #4338ca 0%, #6d28d9 100%);
        transform: translateY(-3px);
        box-shadow: 0 12px 24px -6px rgba(124, 58, 237, 0.4) !important;
        color: #fff;
    }

    .btn-home:active {
        transform: translateY(-1px);
    }

    /* CSS Анимации */
    @@keyframes floatAnimation {
        0%, 100% {
            transform: translateY(0);
        }

        50% {
            transform: translateY(-12px);
        }
    }

    @@keyframes pulseDot {
        0%, 100% {
            opacity: 1;
            transform: scale(1);
        }

        50% {
            opacity: 0.4;
            transform: scale(0.85);
        }
    }
</style>
<!DOCTYPE html>
<html lang="bg" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MallArchitecture</title>

    <!-- Bootstrap CSS & Bootstrap Icons CDN -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <!-- Custom Styles -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MallArchitecture.styles.css" asp-append-version="true" />

    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f8fafc;
            color: #1e293b;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        .glass-navbar {
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border-bottom: 1px solid rgba(226, 232, 240, 0.8);
            transition: all 0.3s ease;
        }

        .navbar-brand {
            font-weight: 700;
            letter-spacing: -0.5px;
            color: #0f172a !important;
            font-size: 1.25rem;
        }

        .navbar-brand i {
            color: #2563eb;
        }

        .footer-custom {
            background-color: #ffffff;
            border-top: 1px solid #e2e8f0;
            margin-top: auto;
            font-size: 0.875rem;
        }

        .footer-custom a {
            color: #64748b;
            text-decoration: none;
            transition: color 0.2s;
        }

        .footer-custom a:hover {
            color: #2563eb;
        }
    </style>

    @await RenderSectionAsync("Design", required: false)
</head>
<body>
    <!-- Header / Navbar -->
    <header class="sticky-top">
        <nav class="navbar navbar-expand-md glass-navbar py-3 shadow-sm">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-bag-heart-fill fs-4"></i>
                    <span>Internet Mall</span>
                </a>

                <button class="navbar-toggler border-0 shadow-none px-0" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav me-auto mb-2 mb-md-0 ms-md-3 gap-1">
                        <!-- Допълнителни навигационни линкове при нужда -->
                    </ul>

                    <div class="d-flex align-items-center gap-3">
                        <partial name="_LoginPartial" />
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <!-- Main Container -->
    <div class="container flex-grow-1 my-4 my-md-5">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- Footer -->
    <footer class="footer-custom py-4">
        <div class="container d-flex flex-column flex-sm-row justify-content-between align-items-center gap-3">
            <div>
                &copy; 2026 <span class="fw-semibold text-dark">Internet Mall</span>. Всички права запазени.
            </div>
            <div class="d-flex gap-4">
                <a href="#"><i class="bi bi-shield-check me-1"></i> Политика за поверителност</a>
                <a href="#"><i class="bi bi-headset me-1"></i> Контакти</a>
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>